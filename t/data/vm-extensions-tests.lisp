;;;; tests/unit/vm/vm-extensions-tests.lisp — VM language extension instruction tests

(in-package #:cl-cc/vm/data/test)



(defun %vm-ext-unary (ctor-fn src-val)
  (let ((s (make-test-vm)))
    (cl-cc/vm:vm-reg-set s 1 src-val)
    (exec1 (funcall ctor-fn :dst 0 :src 1) s)
    (cl-cc/vm:vm-reg-get s 0)))

(defun %vm-ext-binary (ctor-fn lhs rhs)
  (let ((s (make-test-vm)))
    (cl-cc/vm:vm-reg-set s 1 lhs)
    (cl-cc/vm:vm-reg-set s 2 rhs)
    (exec1 (funcall ctor-fn :dst 0 :lhs 1 :rhs 2) s)
    (cl-cc/vm:vm-reg-get s 0)))

(defun register-vm-extensions-tests ()
(it-sequential "vm-symbol-get-default"
  (let ((s (make-test-vm))
        (sym (gensym "VM-SYMBOL-GET-DEFAULT-")))
    (cl-cc/vm:vm-reg-set s 1 sym)
    (cl-cc/vm:vm-reg-set s 2 :color)
    (cl-cc/vm:vm-reg-set s 3 :none)
    (exec1 (cl-cc/vm:make-vm-symbol-get :dst 0 :sym 1 :indicator 2 :default 3) s)
    (expect (cl-cc/vm:vm-reg-get s 0) :to-equal :none)))
(it-sequential "vm-symbol-set-and-get-roundtrip-with-host-sync"
  (let ((s (make-test-vm))
        (sym (gensym "VM-SYMBOL-ROUNDTRIP-")))
    (cl-cc/vm:vm-reg-set s 1 sym)
    (cl-cc/vm:vm-reg-set s 2 :color)
    (cl-cc/vm:vm-reg-set s 3 'red)
    (cl-cc/vm:vm-reg-set s 4 :shape)
    (cl-cc/vm:vm-reg-set s 5 'circle)
    (cl-cc/vm:vm-reg-set s 6 nil)
    (exec1 (cl-cc/vm/data:make-vm-symbol-set :dst 0 :sym 1 :indicator 2 :value 3) s)
    (exec1 (cl-cc/vm/data:make-vm-symbol-set :dst 0 :sym 1 :indicator 4 :value 5) s)
    (exec1 (cl-cc/vm:make-vm-symbol-get :dst 7 :sym 1 :indicator 2 :default 6) s)
    (exec1 (cl-cc/vm:make-vm-symbol-get :dst 8 :sym 1 :indicator 4 :default 6) s)
    (exec1 (cl-cc/vm:make-vm-symbol-plist :dst 9 :src 1) s)
    (expect (cl-cc/vm:vm-reg-get s 7) :to-equal 'red)
    (expect (cl-cc/vm:vm-reg-get s 8) :to-equal 'circle)
    (expect (getf (cl-cc/vm:vm-reg-get s 9) :color) :to-equal 'red)
    (expect (getf (cl-cc/vm:vm-reg-get s 9) :shape) :to-equal 'circle)
    (expect (consp (cl-cc/vm:vm-reg-get s 9)) :to-be-truthy)
    (expect (getf (symbol-plist sym) :color) :to-equal 'red)
    (expect (getf (symbol-plist sym) :shape) :to-equal 'circle)))
(it-sequential "vm-set-symbol-value"
  (let ((s (make-test-vm)))
    (setf (symbol-value 'prim-test-global) 0)
    (cl-cc/vm:vm-reg-set s 1 'prim-test-global)
    (cl-cc/vm:vm-reg-set s 2 77)
    (exec1 (cl-cc/vm:make-vm-set-symbol-value :dst 0 :lhs 1 :rhs 2) s)
    (expect (= 77 (cl-cc/vm:vm-reg-get s 0)) :to-be-truthy)
    (expect (= 77 (symbol-value 'prim-test-global)) :to-be-truthy)))
(it-sequential "vm-remprop"
  (let ((s (make-test-vm))
        (sym (gensym "VM-REMPROP-")))
    (cl-cc/vm:vm-reg-set s 1 sym)
    (cl-cc/vm:vm-reg-set s 2 :color)
    (cl-cc/vm:vm-reg-set s 3 'red)
    (exec1 (cl-cc/vm/data:make-vm-symbol-set :dst 0 :sym 1 :indicator 2 :value 3) s)
    (exec1 (cl-cc/vm:make-vm-remprop :dst 0 :sym 1 :indicator 2) s)
    (expect (cl-cc/vm:vm-reg-get s 0) :to-equal t)
    (expect (getf (symbol-plist sym) :color) :to-be-null)))
(it-sequential "vm-symbol-plist-empty"
  (let ((s (make-test-vm))
        (sym (gensym "VM-SYMBOL-EMPTY-")))
    (cl-cc/vm:vm-reg-set s 1 sym)
    (exec1 (cl-cc/vm:make-vm-symbol-plist :dst 0 :src 1) s)
    (expect (cl-cc/vm:vm-reg-get s 0) :to-be-null)))
(it-sequential "vm-system-property-storage-is-separate"
  (let* ((s (make-test-vm))
         (sym (gensym "VM-SYSTEM-PROPS-"))
         (system-plists
           (cl-cc/vm/data::vm-state-system-symbol-plists s)))
    (cl-cc/vm:vm-reg-set s 1 sym)
    (cl-cc/vm:vm-reg-set s 2 :user)
    (cl-cc/vm:vm-reg-set s 3 :value)
    (exec1 (cl-cc/vm/data:make-vm-symbol-set :dst 0 :sym 1 :indicator 2 :value 3) s)
    (cl-cc/vm/data::%vm-symbol-property-set s system-plists sym :function (quote compiled-fn))
    (cl-cc/vm/data::%vm-symbol-property-set s system-plists sym :type (quote function))
    (exec1 (cl-cc/vm:make-vm-symbol-plist :dst 4 :src 1) s)
    (expect (getf (cl-cc/vm:vm-reg-get s 4) :user) :to-equal :value)
    (expect (getf (cl-cc/vm:vm-reg-get s 4) :function) :to-be-null)
    (expect (cl-cc/vm/data::%vm-symbol-property-get s system-plists sym :function nil) :to-equal (quote compiled-fn))
    (expect (getf (cl-cc/vm/data::%vm-symbol-property-entry->plist (gethash sym system-plists)) :type) :to-equal (quote function))
    (expect (getf (symbol-plist sym) :function) :to-be-null)))
(it-sequential "vm-set-symbol-plist-overwrites-and-promotes-long-plist"
  (let* ((s (make-test-vm))
         (sym (gensym "VM-LONG-PLIST-"))
         (long-plist '(:a 1 :b 2 :c 3 :d 4 :e 5)))
    (cl-cc/vm:vm-reg-set s 1 sym)
    (cl-cc/vm:vm-reg-set s 2 :stale)
    (cl-cc/vm:vm-reg-set s 3 :old)
    (cl-cc/vm:vm-reg-set s 4 long-plist)
    (cl-cc/vm:vm-reg-set s 5 nil)
    (exec1 (cl-cc/vm/data:make-vm-symbol-set :dst 0 :sym 1 :indicator 2 :value 3) s)
    (exec1 (cl-cc/vm:make-vm-set-symbol-plist :dst 6 :sym 1 :plist-reg 4) s)
    (exec1 (cl-cc/vm:make-vm-symbol-get :dst 7 :sym 1 :indicator 2 :default 5) s)
    (exec1 (cl-cc/vm:make-vm-symbol-plist :dst 9 :src 1) s)
    (expect (cl-cc/vm:vm-reg-get s 7) :to-be-null)
    (expect (getf (cl-cc/vm:vm-reg-get s 9) :a) :to-equal 1)
    (expect (getf (cl-cc/vm:vm-reg-get s 9) :e) :to-equal 5)
    (expect (getf (symbol-plist sym) :e) :to-equal 5)
    (expect (cl-cc/vm/data::%vm-symbol-property-entry-p
      (gethash sym (cl-cc/vm/data::vm-state-symbol-plists s))) :to-be-truthy)))
(it-sequential "vm-symbol-plist-lock-and-read-barrier-are-usable"
  (let* ((s (make-test-vm))
         (sym (gensym "VM-BARRIER-"))
         (lock (cl-cc/vm/data::vm-state-symbol-plist-lock s))
         (barrier-before (cl-cc/vm/data::vm-state-symbol-plist-read-barrier s)))
    (expect lock :to-be-truthy)
    (cl-cc/runtime:rt-with-lock (lock)
      (expect (cl-cc/vm/data::vm-state-symbol-plist-read-barrier s) :to-equal barrier-before))
    (cl-cc/vm:vm-reg-set s 1 sym)
    (cl-cc/vm:vm-reg-set s 2 :flag)
    (cl-cc/vm:vm-reg-set s 3 t)
    (exec1 (cl-cc/vm/data:make-vm-symbol-set :dst 0 :sym 1 :indicator 2 :value 3) s)
    (multiple-value-bind (plist barrier-after)
        (cl-cc/vm/data::vm-symbol-plist-read-snapshot s sym)
      (expect (> barrier-after barrier-before) :to-be-truthy)
      (expect (getf plist :flag) :to-equal t))))
)

