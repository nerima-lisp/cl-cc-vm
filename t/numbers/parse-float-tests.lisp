(in-package #:cl-cc/vm/numbers/test)

(defun %vm-parse-float-test-call (string &key start end)
  (let ((state (make-test-vm)))
    (cl-cc/vm:vm-reg-set state 1 string)
    (exec1 (cl-cc/vm:make-vm-parse-float :dst 0 :src 1 :start start :end end)
           state)
    (values (cl-cc/vm:vm-reg-get state 0) (cl-cc/vm:vm-values-list state))))

(defun register-parse-float-tests ()
  (it-sequential "parse-float-decimal-prefixes"
    (dolist (case '(("12.5tail" 12.5d0 4)
                    (".25" 0.25d0 3)
                    ("1." 1.0d0 2)
                    ("1e-2x" 0.01d0 4)
                    ("1e+2tail" 100.0d0 4)
                    ("-.5" -0.5d0 3)
                    ("  +.5e2!" 50.0d0 7)))
      (destructuring-bind (input expected position) case
        (multiple-value-bind (value values-list)
            (%vm-parse-float-test-call input)
          (expect value :to-be expected)
          (expect values-list :to-equal (list expected position)))))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "-0.0")
      (expect (zerop value) :to-be-truthy)
      (expect (minusp (float-sign value)) :to-be-truthy)
      (expect (second values-list) :to-be 4)))
  (it-sequential "parse-float-hexadecimal-prefixes"
    (dolist (case '(("0x1.8p+2tail" 6.0d0 8)
                    ("0X1p-1!" 0.5d0 6)
                    ("0x1" 1.0d0 3)
                    ("0x.8" 0.5d0 4)
                    ("0x1p2tail" 4.0d0 5)))
      (destructuring-bind (input expected position) case
        (multiple-value-bind (value values-list)
            (%vm-parse-float-test-call input)
          (expect value :to-be expected)
          (expect values-list :to-equal (list expected position))))))
  (it-sequential "parse-float-infinity-and-nan-prefixes"
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "+INFINITY rest")
      (expect (sb-ext:float-infinity-p value) :to-be-truthy)
      (expect (second values-list) :to-be 9))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "infinite!")
      (expect (sb-ext:float-infinity-p value) :to-be-truthy)
      (expect (second values-list) :to-be 3))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "-inf!")
      (expect (and (sb-ext:float-infinity-p value) (minusp value))
              :to-be-truthy)
      (expect (second values-list) :to-be 4))
    (dolist (case '(("nan(payload)tail" 12)
                    ("nan()" 5)
                    ("nan(foo-bar)tail" 12)))
      (destructuring-bind (input position) case
        (multiple-value-bind (value values-list)
            (%vm-parse-float-test-call input)
          (expect (sb-ext:float-nan-p value) :to-be-truthy)
          (expect (sb-ext:float-nan-p (first values-list)) :to-be-truthy)
          (expect (second values-list) :to-be position)))))
  (it-sequential "parse-float-start-end-are-absolute-and-end-exclusive"
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "xx -12.5e1 rest" :start 3 :end 10)
      (expect value :to-be -125.0d0)
      (expect values-list :to-equal '(-125.0d0 10)))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "xx -12.5e1 rest" :start 3 :end 9)
      (expect value :to-be -12.5d0)
      (expect values-list :to-equal '(-12.5d0 8))))
  (it-sequential "parse-float-incomplete-exponents-backtrack"
    (dolist (case '(("1e+tail" 1.0d0 1)
                    ("1e-" 1.0d0 1)
                    ("1e-2x" 0.01d0 4)
                    ("0x1p+tail" 1.0d0 3)
                    ("0x1p-" 1.0d0 3)
                    ("0x1p2tail" 4.0d0 5)))
      (destructuring-bind (input expected position) case
        (multiple-value-bind (value values-list)
            (%vm-parse-float-test-call input)
          (expect value :to-be expected)
          (expect values-list :to-equal (list expected position))))))
  (it-sequential "parse-float-rounds-at-double-float-boundaries"
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "1.7976931348623157e308")
      (expect value :to-be most-positive-double-float)
      (expect values-list
              :to-equal
              (list most-positive-double-float 22)))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "5e-324")
      (expect value :to-be least-positive-double-float)
      (expect values-list
              :to-equal
              (list least-positive-double-float 6)))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "0x1p-1074")
      (expect value :to-be least-positive-double-float)
      (expect values-list
              :to-equal
              (list least-positive-double-float 9)))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "0x1p-1075")
      (expect (zerop value) :to-be-truthy)
      (expect (second values-list) :to-be 9))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "1e9999!")
      (expect (sb-ext:float-infinity-p value) :to-be-truthy)
      (expect (second values-list) :to-be 6))
    (multiple-value-bind (value values-list)
        (%vm-parse-float-test-call "-1e-9999")
      (expect (zerop value) :to-be-truthy)
      (expect (second values-list) :to-be 8)))
  (it-sequential "parse-float-invalid-input-signals-error"
    (dolist (input '("" " " "+" "-" "." ".e2" "１２.3"))
      (signals error (%vm-parse-float-test-call input)))
    (let ((dotless-i (code-char #x131)))
      (signals error
        (%vm-parse-float-test-call
         (concatenate 'string (string dotless-i) "nf")))))
  (it-sequential "parse-float-invalid-bounds-signal-error"
    (signals error (%vm-parse-float-test-call "1.0" :start -1))
    (signals error
      (%vm-parse-float-test-call "1.0" :start 2 :end 1))
    (signals error (%vm-parse-float-test-call "1.0" :end 4))))
