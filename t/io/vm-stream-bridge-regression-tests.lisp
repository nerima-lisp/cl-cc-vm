(in-package #:cl-cc/vm/io/test)

(defun %vm-stream-bridge-callable (name)
  (or (cl-cc/vm/protocols:vm-lookup-bridge-callable name)
      (error "No host bridge callable registered for ~S" name)))

(defun register-vm-stream-bridge-regression-tests ()
  (it-sequential "vm-stream-bridge-compound-handles-and-accessors"
                 (let* ((state (io-vm-full))
                        (cl-cc/vm/execution:*vm-current-state* state))
                   (cl-cc/vm/protocols:vm-reg-set state :text-a "ab")
                   (io-exec (cl-cc/vm:make-vm-make-string-stream
                             :dst :input-a :direction :input :initial-string :text-a)
                            state)
                   (cl-cc/vm/protocols:vm-reg-set state :text-b "echo")
                   (io-exec (cl-cc/vm:make-vm-make-string-stream
                             :dst :input-b :direction :input :initial-string :text-b)
                            state)
                   (cl-cc/vm/protocols:vm-reg-set state :text-c "left")
                   (io-exec (cl-cc/vm:make-vm-make-string-stream
                             :dst :input-c :direction :input :initial-string :text-c)
                            state)
                   (cl-cc/vm/protocols:vm-reg-set state :text-d "right")
                   (io-exec (cl-cc/vm:make-vm-make-string-stream
                             :dst :input-d :direction :input :initial-string :text-d)
                            state)
                   (io-exec (cl-cc/vm:make-vm-make-string-stream
                             :dst :output-a :direction :output)
                            state)
                   (io-exec (cl-cc/vm:make-vm-make-string-stream
                             :dst :output-b :direction :output)
                            state)
                   (let ((input-a (cl-cc/vm/protocols:vm-reg-get state :input-a))
                         (input-b (cl-cc/vm/protocols:vm-reg-get state :input-b))
                         (input-c (cl-cc/vm/protocols:vm-reg-get state :input-c))
                         (input-d (cl-cc/vm/protocols:vm-reg-get state :input-d))
                         (output-a (cl-cc/vm/protocols:vm-reg-get state :output-a))
                         (output-b (cl-cc/vm/protocols:vm-reg-get state :output-b)))
                     (let* ((broadcast
                             (funcall (%vm-stream-bridge-callable 'make-broadcast-stream)
                                      output-a output-b))
                            (two-way
                             (funcall (%vm-stream-bridge-callable 'make-two-way-stream)
                                      input-a output-a))
                            (echo
                             (funcall (%vm-stream-bridge-callable 'make-echo-stream)
                                      input-b output-b))
                            (concatenated
                             (funcall (%vm-stream-bridge-callable 'make-concatenated-stream)
                                      input-c input-d)))
                       (write-char #\B broadcast)
                       (expect (funcall (%vm-stream-bridge-callable 'broadcast-stream-streams)
                                        broadcast)
                               :to-equal (list output-a output-b))
                       (expect (get-output-stream-string (cl-cc/vm/io:vm-get-stream state output-a))
                               :to-equal "B")
                       (expect (get-output-stream-string (cl-cc/vm/io:vm-get-stream state output-b))
                               :to-equal "B")
                       (expect (read-char two-way) :to-equal #\a)
                       (write-char #\T two-way)
                       (expect (funcall (%vm-stream-bridge-callable 'two-way-stream-input-stream)
                                        two-way)
                               :to-equal input-a)
                       (expect (funcall (%vm-stream-bridge-callable 'two-way-stream-output-stream)
                                        two-way)
                               :to-equal output-a)
                       (expect (get-output-stream-string (cl-cc/vm/io:vm-get-stream state output-a))
                               :to-equal "T")
                       (expect (read-char echo) :to-equal #\e)
                       (expect (funcall (%vm-stream-bridge-callable 'echo-stream-input-stream)
                                        echo)
                               :to-equal input-b)
                       (expect (funcall (%vm-stream-bridge-callable 'echo-stream-output-stream)
                                        echo)
                               :to-equal output-b)
                       (expect (get-output-stream-string (cl-cc/vm/io:vm-get-stream state output-b))
                               :to-equal "e")
                       (expect (funcall (%vm-stream-bridge-callable 'concatenated-stream-streams)
                                        concatenated)
                               :to-equal (list input-c input-d))
                       (expect (read-char concatenated) :to-equal #\l)
                       (expect (read-char concatenated) :to-equal #\e)
                       (expect (read-char concatenated) :to-equal #\f)
                       (expect (read-char concatenated) :to-equal #\t)
                       (expect (read-char concatenated) :to-equal #\r)))))
  (it-sequential "vm-stream-bridge-synonym-stream-uses-vm-standard-output"
                 (let* ((output (make-string-output-stream))
                        (host-output (make-string-output-stream))
                        (state (io-vm-full output))
                        (cl-cc/vm/execution:*vm-current-state* state)
                        (*standard-output* host-output))
                   (setf (gethash '*standard-output*
                                  (cl-cc/vm/execution:vm-global-vars state))
                         cl-cc/vm/io:+stdout-handle+)
                   (write-string
                    "VM output"
                    (funcall (%vm-stream-bridge-callable 'make-synonym-stream)
                             '*standard-output*))
                   (expect (get-output-stream-string output) :to-equal "VM output")
                   (expect (get-output-stream-string host-output) :to-equal ""))))
